						"itemOffered": {
							"@type": "Service",
							"name": "3D Floor Plans & Cut Sections",
							"description": "Dimensionally accurate 3D floor plan cutouts for high-rise apartments and luxury villas."
						}
					},
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": "Cinematic 3D Walkthrough Animations",
							"description": "Ultra-HD cinematic interior and exterior architectural video walkthroughs for real estate developers."
						}
					}
				]
			},
			"knowsAbout": [
				"Interior Design",
				"Interior Architecture",
				"3D Architectural Visualization",
				"Turnkey Interior Execution",
				"Ceramic Showroom Design",
