---
// src/layouts/Layout.astro
import '../index.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.jsx';
import Cursor from '../components/Cursor.jsx';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image = '/og-image.png' } = Astro.props;
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(pathname, Astro.site || 'https://craftdesignstudio.in');
---

<!doctype html>
<html lang="en">
	<head>
		<ClientRouter />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<link rel="alternate" type="application/rss+xml" title="Craft Design Studio RSS Feed" href="https://craftdesignstudio.in/rss.xml" />
		
		<!-- Preconnect for speed -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Fonts — swap for fast LCP -->
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@300;400;500&display=swap" rel="stylesheet" />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalUrl.href} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, canonicalUrl.href)} />

		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl.href} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, canonicalUrl.href)} />

		<!-- JSON-LD Structured Data for Local SEO (InteriorDesigner & ProfessionalService) -->
		<script type="application/ld+json" is:inline>
		{
			"@context": "https://schema.org",
			"@type": ["InteriorDesigner", "HomeAndConstructionBusiness", "ProfessionalService"],
			"name": "Craft Design Studio",
			"alternateName": "Craft The Design Studio",
			"description": "Morbi & Rajkot's leading interior design and 3D architectural visualization studio. Specializing in luxury turnkey residential interiors, commercial ceramic tile experience centers, 3D floor plans, and photorealistic animation walkthroughs.",
			"url": "https://craftdesignstudio.in/",
			"logo": "https://craftdesignstudio.in/Logo.png",
			"image": "https://craftdesignstudio.in/og-image.png",
			"telephone": ["+918758395671", "+918320695380"],
			"email": "hello@craftdesignstudio.in",
			"foundingDate": "2023",
			"currenciesAccepted": "INR",
			"paymentAccepted": "Cash, Credit Card, Bank Transfer, UPI",
			"priceRange": "$$",
			"openingHours": "Mo-Sa 09:00-19:00",
			"founder": [
				{
					"@type": "Person",
					"name": "Vishvarajsinh Zala",
					"jobTitle": "Co-Founder & Design Director"
				},
				{
					"@type": "Person",
					"name": "Yash Gharvaliya",
					"jobTitle": "Co-Founder & Visualization Lead"
				}
			],
			"address": [
				{
					"@type": "PostalAddress",
					"streetAddress": "1st Floor, Shreeji Arcade, Opposite VI Store, Sanala Road",
					"addressLocality": "Morbi",
					"addressRegion": "Gujarat",
					"postalCode": "363641",
					"addressCountry": "IN"
				},
				{
					"@type": "PostalAddress",
					"streetAddress": "Kataria Chowkdi, Near Housing",
					"addressLocality": "Rajkot",
					"addressRegion": "Gujarat",
					"postalCode": "360004",
					"addressCountry": "IN"
				}
			],
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": "22.8133765",
				"longitude": "70.8297183"
			},
			"areaServed": [
				{
					"@type": "City",
					"name": "Morbi",
					"sameAs": "https://en.wikipedia.org/wiki/Morbi"
				},
				{
					"@type": "City",
